[importlinter]
root_package = grillmaster

[importlinter:contract:layers]
name = Layered architecture (design §5.1)
type = layers
layers =
    (grillmaster.cli)
    (grillmaster.tui) | (grillmaster.pipeline)
    (grillmaster.stages)
    (grillmaster.translate) | (grillmaster.postprocess) | (grillmaster.extras) | (grillmaster.package)
    (grillmaster.live_chat) | (grillmaster.agent_tools)
    (grillmaster.sources) | (grillmaster.asr) | (grillmaster.subtitles)
    (grillmaster.agents)
    (grillmaster.project) | (grillmaster.config)
    (grillmaster.media) | (grillmaster.glossary)
    grillmaster.core | grillmaster.events

[importlinter:contract:domain-purity]
# Extend source_modules as each new domain package lands.
name = Foundation and domain modules never import project, config or legacy
type = forbidden
source_modules =
    grillmaster.core
    grillmaster.events
    grillmaster.media
    grillmaster.subtitles
    grillmaster.agent_tools
    grillmaster.agents
    grillmaster.glossary
    grillmaster.live_chat
    grillmaster.asr
    grillmaster.sources
    grillmaster.translate
    grillmaster.postprocess
    grillmaster.extras
    grillmaster.package
    grillmaster.tui
forbidden_modules =
    grillmaster.project
    grillmaster.config
    grillmaster.legacy

[importlinter:contract:project-foundation]
name = project builds on core alone (design §5.1)
type = forbidden
source_modules =
    grillmaster.project
forbidden_modules =
    grillmaster.events
    grillmaster.legacy

[importlinter:contract:config-foundation]
name = config builds on core alone (design §5.1)
type = forbidden
source_modules =
    grillmaster.config
forbidden_modules =
    grillmaster.events
    grillmaster.legacy

[importlinter:contract:tui-events-only]
name = tui consumes events only (design §8)
type = forbidden
source_modules =
    grillmaster.tui
forbidden_modules =
    grillmaster.stages
    grillmaster.translate
    grillmaster.postprocess
    grillmaster.extras
    grillmaster.package
    grillmaster.live_chat
    grillmaster.agent_tools
    grillmaster.sources
    grillmaster.asr
    grillmaster.subtitles
    grillmaster.agents
    grillmaster.media
    grillmaster.glossary
